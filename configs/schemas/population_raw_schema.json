{
  "dataset_name": "population_raw",
  "business_keys": ["date", "state", "district", "pincode"],
  "date_formats": ["dd-MM-yyyy", "yyyy-MM-dd"],
  "timestamp_formats": ["yyyy-MM-dd'T'HH:mm:ss'Z'", "yyyy-MM-dd HH:mm:ss"],
  "columns": [
    {"name": "date", "type": "date", "nullable": false, "aliases": ["date", "dt", "record_date"]},
    {"name": "state", "type": "string", "nullable": false, "aliases": ["state", "state_name"], "max_length": 120},
    {"name": "district", "type": "string", "nullable": false, "aliases": ["district", "district_name"], "max_length": 120},
    {"name": "pincode", "type": "string", "nullable": false, "aliases": ["pincode", "pin_code", "pin", "postal_code"], "pattern": "^[0-9]{6}$"},
    {"name": "population_total", "type": "long", "nullable": false, "aliases": ["population_total"], "min_value": 0},
    {"name": "male", "type": "long", "nullable": false, "aliases": ["male", "male_population"], "min_value": 0},
    {"name": "female", "type": "long", "nullable": false, "aliases": ["female", "female_population"], "min_value": 0},
    {"name": "age_0_5", "type": "long", "nullable": false, "aliases": ["age_0_5"], "min_value": 0},
    {"name": "age_6_17", "type": "long", "nullable": false, "aliases": ["age_6_17", "age_5_17"], "min_value": 0},
    {"name": "age_18_plus", "type": "long", "nullable": false, "aliases": ["age_18_plus", "age_18_greater"], "min_value": 0},
    {"name": "source_system", "type": "string", "nullable": true, "aliases": ["source_system", "source", "data_source"], "max_length": 100},
    {"name": "ingest_ts", "type": "timestamp", "nullable": true, "aliases": ["ingest_ts", "ingestion_ts", "ingested_at"]},
    {"name": "batch_id", "type": "string", "nullable": true, "aliases": ["batch_id", "batch"], "max_length": 120},
    {"name": "bronze_ingest_ts", "type": "timestamp", "nullable": false, "aliases": ["bronze_ingest_ts"]},
    {"name": "bronze_source_file", "type": "string", "nullable": false, "aliases": ["bronze_source_file", "source_file"], "max_length": 500},
    {"name": "bronze_batch_id", "type": "string", "nullable": false, "aliases": ["bronze_batch_id"], "max_length": 120},
    {"name": "partition_year", "type": "int", "nullable": true, "aliases": ["partition_year"]},
    {"name": "partition_month", "type": "int", "nullable": true, "aliases": ["partition_month"]},
    {"name": "silver_processed_ts", "type": "timestamp", "nullable": false, "aliases": ["silver_processed_ts"]},
    {"name": "silver_run_id", "type": "string", "nullable": false, "aliases": ["silver_run_id"], "max_length": 120}
  ]
}
